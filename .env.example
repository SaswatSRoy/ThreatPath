# ThreatPath Environment Configuration Template
# Copy to .env for local development or set in your deployment platform (e.g. Railway)

# Application Environment (development | production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# PORT is automatically injected by Railway/PaaS platforms
# PORT=8000

# FalkorDB Database Connection
# In local development: point to local container (127.0.0.1:6379, threatpath_dev, no password)
# In production: point to private service name (e.g., falkordb.railway.internal), port 6379, graph threatpath_demo, strong password
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=threatpath_dev

# AI / LLM Configuration
# Set LLM_PROVIDER to "mock" for deterministic evaluation (no API key required)
# Supported external providers: "openai", "anthropic", "gemini"
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# Agent Investigation & Safety Controls
AGENT_MAX_TOOL_ROUNDS=6
AGENT_TOOL_TIMEOUT_SECONDS=10
ENABLE_SIMULATED_RESPONSES=true
